rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bootstrap access expires permanently once the authority document exists.
    function initialAdministrator() {
      return request.auth != null
        && request.auth.uid == 'Kgwk4gK0yxYJQMZZaggIyl2xtnh2'
        && !exists(/databases/$(database)/documents/security/authority);
    }
    function administrator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/security/authority)
        && request.auth.uid == get(/databases/$(database)/documents/security/authority).data.administratorUid;
    }
    match /security/authority {
      allow get: if request.auth != null;
      allow create: if initialAdministrator()
        && request.resource.data.keys().hasOnly(['administratorUid', 'updatedAt'])
        && request.resource.data.administratorUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if administrator()
        && request.resource.data.keys().hasOnly(['administratorUid', 'updatedAt'])
        && request.resource.data.administratorUid is string
        && request.resource.data.administratorUid.size() > 0
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function activeOperator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['member', 'operator', 'supervisor'];
    }
    match /migrationBackups/{backupId} {
      allow read: if administrator();
      allow create: if administrator();
      allow update, delete: if false;
      match /chunks/{chunkId} {
        allow read, create: if administrator();
        allow update, delete: if false;
      }
    }
    match /profiles/{uid} {
      allow get: if administrator() || activeOperator() || (request.auth != null && request.auth.uid == uid);
      allow list: if administrator() || activeOperator();
      allow create, update: if administrator()
        && (request.resource.data.role in ['member', 'operator', 'supervisor'] || (uid == get(/databases/$(database)/documents/security/authority).data.administratorUid && request.resource.data.role == 'admin'))
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    function owns(record) {
      return record.get('ownerAccountId', '') == request.auth.uid
        || record.get('assignedAccountId', '') == request.auth.uid;
    }
    function canEdit(kind) {
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      return activeOperator() && profile.get('permissions', {}).get(kind, true) == true;
    }
    function canViewAll() {
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      return activeOperator() && profile.get('permissions', {}).get('view_all', false) == true;
    }
    function sessionOwner() {
      return administrator() || activeOperator();
    }
    function allowedUnit(data) {
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
      return !profile.get('restrictUnits', false) || profile.get('allowedUnits', []).size() == 0
        || data.get('unit', '') in profile.get('allowedUnits', [])
        || data.get('area', '') in profile.get('allowedUnits', [])
        || data.get('unidad', '') in profile.get('allowedUnits', []);
    }
    function readOperation(kind) {
      return activeOperator() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('permissions', {}).get(kind, true) == true;
    }
    function validDateString(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Critical fields are type/range checked whenever present. Drafts may omit
    // fields that the app fills later; terminal states require their coherence.
    function validActionWrite(data) {
      return data.status in ['Pendiente', 'Por verificar', 'Cerrado']
        && (!('progress' in data) || (data.progress is int && data.progress >= 0 && data.progress <= 100))
        && (!('start' in data) || validDateString(data.start))
        && (!('due' in data) || validDateString(data.due))
        && (!('start' in data) || !('due' in data) || data.start <= data.due)
        && (!('description' in data) || (data.description is string && data.description.size() <= 12000))
        && (!('owner' in data) || (data.owner is string && data.owner.size() <= 200))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 200))
        && (!('requester' in data) || (data.requester is string && data.requester.size() <= 200))
        && (!('source' in data) || (data.source is string && data.source.size() <= 200))
        && (!('priority' in data) || data.priority in ['Baja', 'Media', 'Alta'])
        && (data.status != 'Cerrado' || (
          data.progress is int && data.progress == 100
          && data.verifiedDate is string && validDateString(data.verifiedDate)
          && (!('start' in data) || data.verifiedDate >= data.start)
          && data.verifier is string && data.verifier.size() > 0));
    }
    function validReportWrite(data) {
      return data.status in ['Borrador', 'Finalizado']
        && (!('type' in data) || (data.type is string && data.type.size() > 0 && data.type.size() <= 80))
        && (!('date' in data) || validDateString(data.date))
        && (!('supervisor' in data) || (data.supervisor is string && data.supervisor.size() <= 200))
        && (!('revision' in data) || data.revision is int)
        && (!('photos' in data) || data.photos is list)
        && (!('photoChunkIds' in data) || data.photoChunkIds is list);
    }
    function validPlanWrite(data) {
      return (!('period' in data) || (data.period is string && data.period.matches('^[0-9]{4}-[0-9]{2}$')))
        && (!('person' in data) || (data.person is string && data.person.size() <= 200))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 200))
        && (!('department' in data) || (data.department is string && data.department.size() <= 200))
        && (!('kpi' in data) || data.kpi == '1' || data.kpi == '2' || data.kpi == 1 || data.kpi == 2)
        && (!('targets' in data) || data.targets is map);
    }
    function validRecordWrite(kind, data) {
      return (kind != 'actions' || validActionWrite(data))
        && (kind != 'reports' || validReportWrite(data))
        && (kind != 'plans' || validPlanWrite(data));
    }
    match /{kind}/{recordId} {
      allow get: if kind in ['reports', 'actions', 'plans'] && (administrator() || (readOperation(kind) && (!exists(/databases/$(database)/documents/$(kind)/$(recordId)) || (allowedUnit(resource.data) && (canViewAll() || owns(resource.data))))));
      allow list: if kind in ['reports', 'actions', 'plans'] && (administrator() || (readOperation(kind) && allowedUnit(resource.data) && (canViewAll() || owns(resource.data))));
      allow create: if kind in ['reports', 'actions', 'plans'] && validRecordWrite(kind, request.resource.data) && (administrator() ||
        (kind != 'plans' && canEdit(kind == 'reports' ? 'edit_reports' : 'edit_actions') && allowedUnit(request.resource.data)
        && request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.get('assignedAccountId', request.auth.uid) == request.auth.uid
        && (kind != 'actions' || request.resource.data.status != 'Cerrado')));
      allow update: if kind in ['reports', 'actions', 'plans'] && validRecordWrite(kind, request.resource.data) && (administrator() ||
        (kind != 'plans' && canEdit(kind == 'reports' ? 'edit_reports' : 'edit_actions') && allowedUnit(resource.data) && allowedUnit(request.resource.data)
        && owns(resource.data)
        && request.resource.data.get('ownerAccountId', '') == resource.data.get('ownerAccountId', '')
        && request.resource.data.get('assignedAccountId', '') == resource.data.get('assignedAccountId', '')
        && request.resource.data.revision == resource.data.revision + 1
        && (kind != 'actions' || (resource.data.status != 'Cerrado' && request.resource.data.status != 'Cerrado'))));
      allow delete: if false;
    }
    match /notices/{noticeId} {
      allow read: if administrator() || (activeOperator() && (resource.data.toAccountId == request.auth.uid || resource.data.fromAccountId == request.auth.uid));
      allow create: if (administrator() || canEdit('send_notices'))
        && request.resource.data.fromAccountId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && (request.resource.data.type != 'Observación' || administrator());
      allow update, delete: if false;
    }
    match /noticeImages/{imageId} {
      allow get: if administrator() || (activeOperator() &&
        (resource.data.fromAccountId == request.auth.uid || request.auth.uid in resource.data.toAccountIds));
      allow list: if administrator() || (activeOperator() && resource.data.fromAccountId == request.auth.uid);
      allow create: if (administrator() || canEdit('send_notices'))
        && request.resource.data.fromAccountId == request.auth.uid
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 900000
        && request.resource.data.toAccountIds is list;
      allow update, delete: if false;
    }
    match /evidenceChunks/{chunkId} {
      allow get: if administrator() || (readOperation(resource.data.recordCollection)
        && allowedUnit(get(/databases/$(database)/documents/$(resource.data.recordCollection)/$(resource.data.recordId)).data)
        && (canViewAll() || owns(get(/databases/$(database)/documents/$(resource.data.recordCollection)/$(resource.data.recordId)).data)));
      allow list: if administrator();
      allow create: if administrator() || (activeOperator()
        && request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.recordCollection in ['reports', 'actions']
        && canEdit(request.resource.data.recordCollection == 'reports' ? 'edit_reports' : 'edit_actions')
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 500000
        && (!exists(/databases/$(database)/documents/$(request.resource.data.recordCollection)/$(request.resource.data.recordId)) ||
        owns(get(/databases/$(database)/documents/$(request.resource.data.recordCollection)/$(request.resource.data.recordId)).data)));
      allow update, delete: if false;
    }
    match /noticeReads/{uid}/items/{noticeId} {
      allow read: if administrator() || (request.auth != null && (request.auth.uid == uid || get(/databases/$(database)/documents/notices/$(noticeId)).data.fromAccountId == request.auth.uid));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (administrator() || get(/databases/$(database)/documents/notices/$(noticeId)).data.toAccountId == uid);
      allow delete: if false;
    }
    match /auditLog/{entryId} {
      allow read: if administrator();
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['actorUid','action','target','createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /sessions/{sessionId} {
      allow read: if administrator() || (activeOperator() && resource.data.userId == request.auth.uid);
      allow create: if sessionOwner()
        && request.resource.data.keys().hasOnly(['userId', 'startedAt', 'updatedAt', 'activeMs', 'closed'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.activeMs == 0
        && request.resource.data.closed == false;
      allow update: if sessionOwner()
        && resource.data.userId == request.auth.uid
        && resource.data.closed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'activeMs', 'closed'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.closed is bool
        && request.resource.data.activeMs is int
        && request.resource.data.activeMs >= resource.data.activeMs;
      allow delete: if false;
    }
    // Additive suite collections. Deploy only after the suite acceptance tests.
    function suiteMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.active == true;
    }
    function suitePermission(key) {
      return administrator() || (suiteMember() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('permissions', {}).get(key, false) == true);
    }
    function officialNormSource(source) {
      return source is string && source.matches('https://([a-zA-Z0-9-]+[.])*(stps[.]gob[.]mx|dof[.]gob[.]mx|diariooficial[.]gob[.]mx|sidof[.]segob[.]gob[.]mx)/.*');
    }
    function suiteCreate() {
      return request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == 1;
    }
    function suiteUpdate() {
      return request.resource.data.ownerAccountId == resource.data.ownerAccountId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && (administrator() || request.resource.data.get('assignedAccountId', '') == resource.data.get('assignedAccountId', ''));
    }
    function validTopic() {
      let data = request.resource.data;
      return data.title is string && data.title.size() > 0
        && data.status in ['Propuesta','Borrador','En revisión','Aprobado','Archivado']
        && (data.status != 'Aprobado' || (suitePermission('training_approve')
          && data.approver == request.auth.uid
          && data.reviewedAt is string && data.reviewedAt.size() > 0
          && data.objective is string && data.objective.size() > 0
          && data.introduction is string && data.introduction.size() > 0
          && data.development is string && data.development.size() > 0
          && data.criticalPoints is list && data.criticalPoints.size() > 0
          && data.reviewQuestions is list && data.reviewQuestions.size() > 0));
    }
    function validSchedule() {
      let data = request.resource.data;
      return data.status in ['Programada','Reprogramada','Cancelada','Ejecutada']
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.minutes is number && data.minutes > 0
        && data.shift is string && data.shift.size() > 0
        && data.department is string && data.department.size() > 0
        && data.place is string && data.place.size() > 0
        && data.instructorId is string && data.instructorId.size() > 0
        && data.assignedAccountId == data.instructorId
        && exists(/databases/$(database)/documents/talk_topics/$(data.topicId));
    }
    function validTalkSession() {
      let data = request.resource.data;
      let schedule = get(/databases/$(database)/documents/talk_schedules/$(data.scheduleId)).data;
      let topic = get(/databases/$(database)/documents/talk_topic_versions/$(data.topicId + '--' + string(data.topicRevision))).data;
      return data.status == 'Ejecutada'
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.minutes is number && data.minutes > 0
        && data.attendees is list && data.attendees.size() > 0
        && schedule.topicId == data.topicId && schedule.status != 'Cancelada'
        && (administrator() || owns(schedule))
        && data.assignedAccountId == schedule.instructorId
        && topic.status == 'Aprobado' && data.topicRevision == topic.revision;
    }
    function validComplianceAssessment() {
      let data = request.resource.data;
      return data.state in ['Pendiente de evaluar','Cumple, con evidencia revisada','No cumple','No aplica, con justificación','Información insuficiente']
        && data.department is string && data.department.size() > 0
        && data.responsibleId is string && data.responsibleId.size() > 0
        && get(/databases/$(database)/documents/standard_requirements/$(data.requirementId)).data.versionId == data.versionId
        && (data.state != 'No aplica, con justificación' || (data.applicabilityJustification is string && data.applicabilityJustification.size() > 0));
    }
    match /regulatory_versions/{versionId} {
      allow read: if suiteMember();
      allow create: if suitePermission('nom_manage') && suiteCreate()
        && request.resource.data.versionId == versionId
        && request.resource.data.status in ['Vigente','Sustituida','Cancelada','Proyecto','Pendiente de verificar']
        && officialNormSource(request.resource.data.sourceUrl)
        && (request.resource.data.status == 'Pendiente de verificar' ||
          (suitePermission('nom_validate') && request.resource.data.verifiedBy == request.auth.uid && request.resource.data.verifiedAt is string));
      allow update, delete: if false;
    }
    match /standard_requirements/{requirementId} {
      allow read: if suiteMember();
      allow create: if suitePermission('nom_validate') && suiteCreate()
        && request.resource.data.section is string && request.resource.data.section.size() > 0
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt is string
        && officialNormSource(request.resource.data.sourceUrl)
        && exists(/databases/$(database)/documents/regulatory_versions/$(request.resource.data.versionId));
      allow update, delete: if false;
    }
    match /talk_topics/{topicId} {
      allow read: if suiteMember();
      allow create: if suitePermission('training_manage') && suiteCreate() && validTopic()
        && getAfter(/databases/$(database)/documents/talk_topic_versions/$(topicId + '--' + string(request.resource.data.revision))).data.topicId == topicId;
      allow update: if suitePermission('training_manage') && suiteUpdate() && validTopic()
        && getAfter(/databases/$(database)/documents/talk_topic_versions/$(topicId + '--' + string(request.resource.data.revision))).data.topicId == topicId;
      allow delete: if false;
    }
    match /talk_topic_versions/{versionId} {
      allow read: if suiteMember();
      allow create: if suitePermission('training_manage')
        && versionId == request.resource.data.topicId + '--' + string(request.resource.data.revision)
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/talk_topics/$(request.resource.data.topicId)).data).affectedKeys().hasOnly(['topicId'])
        && getAfter(/databases/$(database)/documents/talk_topics/$(request.resource.data.topicId)).data.revision == request.resource.data.revision
        && request.resource.data.createdBy == getAfter(/databases/$(database)/documents/talk_topics/$(request.resource.data.topicId)).data.createdBy
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    match /talk_schedules/{scheduleId} {
      allow get: if administrator() || (suiteMember() && (!exists(/databases/$(database)/documents/talk_schedules/$(scheduleId)) || owns(resource.data)));
      allow list: if administrator() || (suiteMember() && owns(resource.data));
      allow create: if suitePermission('training_schedule') && suiteCreate() && validSchedule();
      allow update: if suitePermission('training_schedule') && (administrator() || owns(resource.data)) && suiteUpdate() && validSchedule();
      allow delete: if false;
    }
    match /talk_sessions/{sessionId} {
      allow get: if administrator() || (suiteMember() && (!exists(/databases/$(database)/documents/talk_sessions/$(sessionId)) || owns(resource.data)));
      allow list: if administrator() || (suiteMember() && owns(resource.data));
      allow create: if suitePermission('training_attendance') && suiteCreate() && validTalkSession();
      allow update: if suitePermission('training_attendance') && (administrator() || owns(resource.data)) && suiteUpdate()
        && request.resource.data.scheduleId == resource.data.scheduleId
        && request.resource.data.topicId == resource.data.topicId && validTalkSession();
      allow delete: if false;
    }
    function reviewedCompliance(assessmentId) {
      return request.resource.data.state != 'Cumple, con evidencia revisada' ||
        (suitePermission('nom_validate')
        && getAfter(/databases/$(database)/documents/compliance_reviews/$(request.resource.data.evidenceReviewId)).data.assessmentId == assessmentId
        && getAfter(/databases/$(database)/documents/compliance_reviews/$(request.resource.data.evidenceReviewId)).data.requirementId == request.resource.data.requirementId
        && getAfter(/databases/$(database)/documents/compliance_reviews/$(request.resource.data.evidenceReviewId)).data.reviewedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/compliance_reviews/$(request.resource.data.evidenceReviewId)).data.reviewedAt == request.time
        && request.resource.data.evidenceReviewId == assessmentId + '--' + string(request.resource.data.revision)
        && request.resource.data.evidence is list && request.resource.data.evidence.size() > 0
        && request.resource.data.evaluatedBy == request.auth.uid
        && request.resource.data.evaluatedAt is string);
    }
    match /compliance_reviews/{reviewId} {
      allow read: if suitePermission('nom_validate');
      allow create: if suitePermission('nom_validate')
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.evidenceIds is list
        && request.resource.data.evidenceIds.size() > 0;
      allow update, delete: if false;
    }
    match /compliance_assessments/{assessmentId} {
      allow get: if administrator() || (suiteMember() && (!exists(/databases/$(database)/documents/compliance_assessments/$(assessmentId)) || owns(resource.data)));
      allow list: if administrator() || (suiteMember() && owns(resource.data));
      allow create: if suitePermission('nom_assess') && suiteCreate() && validComplianceAssessment()
        && reviewedCompliance(assessmentId);
      allow update: if suitePermission('nom_assess') && (administrator() || owns(resource.data)) && suiteUpdate() && validComplianceAssessment()
        && reviewedCompliance(assessmentId);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
